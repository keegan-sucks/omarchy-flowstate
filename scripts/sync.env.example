# Credentials for the optional weekly Liked-mirror sync (scripts/sync-liked-playlist.py).
# scripts/setup-liked.sh writes this for you; by hand: copy to ~/.config/flowstate/sync.env,
# fill in your Client ID, then chmod 600.
# From your Spotify app at https://developer.spotify.com/dashboard.
#
# PKCE flow — only a Client ID is needed. There is NO client secret.
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
